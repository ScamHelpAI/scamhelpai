# Required
OPENAI_API_KEY=
DATABASE_URL=postgres://scamhelp:scamhelp@localhost:5433/scamhelp

# Cache (docker-compose redis on host port 6380)
REDIS_URL=redis://localhost:6380

# Object storage (docker-compose minio on host ports 9100 / 9101)
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=scamhelp-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Recommended — threat intel (VirusTotal covers URL, domain, IP, hash, file)
VIRUSTOTAL_API_KEY=

# Optional — threat intel fallbacks
PHISHTANK_API_KEY=
ABUSEIPDB_API_KEY=
URLHAUS_AUTH_KEY=

# Optional — enrichment
CHAINABUSE_API_KEY=
ETHERSCAN_API_KEY=

# Server
PORT=3000
