{
  "manifest_version": 3,
  "name": "ScamHelp AI",
  "version": "0.1.0",
  "description": "Check suspicious emails, messages, and URLs for scam signals.",
  "action": {
    "default_popup": "index.html",
    "default_title": "ScamHelp AI"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/links.js"],
      "run_at": "document_idle"
    }
  ]
}
